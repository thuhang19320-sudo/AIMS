digraph Classes {graph [rankdir=LR,label="AIMS Cart Management - Class Diagram",labelloc=t,fontsize=20]; node [shape=record]; Aims [label="{Aims|+ main(args: String[]): void}"]; DigitalVideoDisc [label="{DigitalVideoDisc|- title: String\l- category: String\l- director: String\l- length: int\l- cost: float\l|+ getTitle(): String\l+ getCategory(): String\l+ getDirector(): String\l+ getLength(): int\l+ getCost(): float\l+ constructors(...)\l}"]; Cart [label="{Cart|- itemsOrdered: DigitalVideoDisc[20]\l- qtyOrdered: int\l|+ addDigitalVideoDisc(disc): void\l+ removeDigitalVideoDisc(disc): void\l+ totalCost(): float\l+ getQtyOrdered(): int\l}"]; Aims -> Cart [label="creates"]; Cart -> DigitalVideoDisc [arrowhead=diamond,label="contains 0..20"]; }